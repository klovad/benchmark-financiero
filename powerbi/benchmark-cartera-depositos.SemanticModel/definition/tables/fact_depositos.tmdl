table fact_depositos
	lineageTag: 10000000-0000-0000-0000-000000000060

	measure 'Saldo Depositos' = SUM(fact_depositos[saldo])
		formatString: #,##0
		lineageTag: 10000000-0000-0000-0000-0000000000b1

	measure 'Saldo Depositos (Ultimo Mes)' = ```
			VAR UltimaFecha = CALCULATE(MAX(dim_fecha[fecha]), ALL(dim_fecha))
			RETURN CALCULATE([Saldo Depositos], dim_fecha[fecha] = UltimaFecha)
			```
		formatString: #,##0
		lineageTag: 10000000-0000-0000-0000-0000000000b9

	measure 'Numero Clientes' = SUM(fact_depositos[numero_clientes])
		formatString: #,##0
		lineageTag: 10000000-0000-0000-0000-0000000000b2

	measure 'Numero Cuentas' = SUM(fact_depositos[numero_cuentas])
		formatString: #,##0
		lineageTag: 10000000-0000-0000-0000-0000000000b3

	measure 'Market Share Banco (Depositos)' = ```
			DIVIDE(
			    [Saldo Depositos],
			    CALCULATE([Saldo Depositos], ALL(dim_banco))
			)
			```
		formatString: 0.00%
		lineageTag: 10000000-0000-0000-0000-0000000000b4

	measure 'HHI Depositos' = ```
			SUMX(
			    VALUES(dim_banco[banco]),
			    [Market Share Banco (Depositos)] ^ 2
			) * 10000
			```
		formatString: #,##0
		lineageTag: 10000000-0000-0000-0000-0000000000b5

	measure 'Variacion Depositos MoM' = ```
			VAR Actual = [Saldo Depositos]
			VAR Anterior = CALCULATE([Saldo Depositos], DATEADD(dim_fecha[fecha], -1, MONTH))
			RETURN DIVIDE(Actual - Anterior, Anterior)
			```
		formatString: 0.00%
		lineageTag: 10000000-0000-0000-0000-0000000000b6

	measure 'Variacion Depositos YoY' = ```
			VAR Actual = [Saldo Depositos]
			VAR Anterior = CALCULATE([Saldo Depositos], DATEADD(dim_fecha[fecha], -12, MONTH))
			RETURN DIVIDE(Actual - Anterior, Anterior)
			```
		formatString: 0.00%
		lineageTag: 10000000-0000-0000-0000-0000000000b7

	measure 'Ratio Cartera / Depositos' = DIVIDE([Saldo Cartera], [Saldo Depositos])
		formatString: 0.00
		lineageTag: 10000000-0000-0000-0000-0000000000b8

