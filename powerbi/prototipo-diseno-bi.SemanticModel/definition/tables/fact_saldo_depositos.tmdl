table fact_saldo_depositos
	lineageTag: 20000000-0000-0000-0000-000000000060

	measure 'Saldo Depositos' = SUM(fact_saldo_depositos[saldo])
		formatString: #,##0
		lineageTag: 20000000-0000-0000-0000-0000000000b1

	measure 'Saldo Depositos (Ultimo Mes)' =
			VAR UltimaFecha = CALCULATE(MAX(dim_fecha[fecha]), ALL(dim_fecha))
			RETURN CALCULATE([Saldo Depositos], dim_fecha[fecha] = UltimaFecha)
		formatString: #,##0
		lineageTag: 20000000-0000-0000-0000-0000000000b2

	column fact_saldo_depositos_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 20000000-0000-0000-0000-000000000061
		summarizeBy: none
		sourceColumn: fact_saldo_depositos_id

	column fecha_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 20000000-0000-0000-0000-000000000062
		summarizeBy: none
		sourceColumn: fecha_id

	column banco_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 20000000-0000-0000-0000-000000000063
		summarizeBy: none
		sourceColumn: banco_id

	column saldo
		dataType: double
		formatString: #,##0.00
		lineageTag: 20000000-0000-0000-0000-000000000064
		summarizeBy: sum
		sourceColumn: saldo

	partition fact_saldo_depositos = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost", "benchmark_cartera_depositos"),
					marts_fact_saldo_depositos = Source{[Schema="marts",Item="fact_saldo_depositos"]}[Data]
				in
					marts_fact_saldo_depositos

	annotation PBI_ResultType = Table
