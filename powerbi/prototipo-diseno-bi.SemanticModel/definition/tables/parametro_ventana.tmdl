table 'Parametro Ventana'
	lineageTag: 20000000-0000-0000-0000-000000000090

	measure 'Meses Ventana Seleccionada' =
			SELECTEDVALUE('Parametro Ventana'[Meses], 12)
		formatString: 0
		lineageTag: 20000000-0000-0000-0000-0000000000e1

	measure 'Incluir En Ventana' =
			VAR MesesSeleccionados = SELECTEDVALUE('Parametro Ventana'[Meses], 999)
			VAR UltimaFecha = CALCULATE(MAX(dim_fecha[fecha]), ALL(dim_fecha))
			VAR FechaMinima = EDATE(UltimaFecha, -MesesSeleccionados)
			RETURN IF(MesesSeleccionados >= 999 || MAX(dim_fecha[fecha]) > FechaMinima, 1, 0)
		formatString: 0
		lineageTag: 20000000-0000-0000-0000-0000000000e2

	measure 'Titulo Ventana Seleccionada' =
			SELECTEDVALUE('Parametro Ventana'[Ventana], "Últimos 12 meses")
		lineageTag: 20000000-0000-0000-0000-0000000000e3

	column Ventana
		dataType: string
		lineageTag: 20000000-0000-0000-0000-000000000091
		summarizeBy: none
		sourceColumn: Ventana
		sortByColumn: Orden

	column Meses
		dataType: int64
		formatString: 0
		lineageTag: 20000000-0000-0000-0000-000000000092
		summarizeBy: none
		sourceColumn: Meses
		isHidden

	column Orden
		dataType: int64
		formatString: 0
		lineageTag: 20000000-0000-0000-0000-000000000093
		summarizeBy: none
		sourceColumn: Orden
		isHidden

	partition 'Parametro Ventana' = calculated
		mode: import
		source =
				DATATABLE(
				    "Ventana", STRING,
				    "Meses", INTEGER,
				    "Orden", INTEGER,
				    {
				        {"Últimos 3 meses", 3, 1},
				        {"Últimos 6 meses", 6, 2},
				        {"Últimos 12 meses", 12, 3},
				        {"Todo el histórico", 999, 4}
				    }
				)
