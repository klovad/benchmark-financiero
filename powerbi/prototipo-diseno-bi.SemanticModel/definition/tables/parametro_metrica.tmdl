table 'Parametro Metrica'
	lineageTag: 20000000-0000-0000-0000-000000000070

	measure 'Valor Metrica Base' =
			SWITCH(
			    SELECTEDVALUE('Parametro Metrica'[Metrica], "Saldo Cartera"),
			    "Saldo Cartera", [Saldo Cartera],
			    "Saldo Depósitos", [Saldo Depositos],
			    [Saldo Cartera]
			)
		formatString: #,##0
		lineageTag: 20000000-0000-0000-0000-0000000000c1

	measure 'Valor Metrica (Ultimo Mes)' =
			VAR UltimaFecha = CALCULATE(MAX(dim_fecha[fecha]), ALL(dim_fecha))
			RETURN CALCULATE([Valor Metrica Base], dim_fecha[fecha] = UltimaFecha)
		formatString: #,##0
		lineageTag: 20000000-0000-0000-0000-0000000000c2

	measure 'Titulo Metrica Seleccionada' =
			SELECTEDVALUE('Parametro Metrica'[Metrica], "Saldo Cartera") & " — último mes"
		lineageTag: 20000000-0000-0000-0000-0000000000c3

	measure 'Titulo Dinamico Prototipo' =
			SELECTEDVALUE('Parametro Metrica'[Metrica], "Saldo Cartera") & " · " &
			SELECTEDVALUE('Parametro Periodo'[Periodo], "Mes Actual") & " · tendencia: " &
			SELECTEDVALUE('Parametro Ventana'[Ventana], "Últimos 12 meses")
		lineageTag: 20000000-0000-0000-0000-0000000000c4

	column Metrica
		dataType: string
		lineageTag: 20000000-0000-0000-0000-000000000071
		summarizeBy: none
		sourceColumn: Metrica
		sortByColumn: Orden

	column Orden
		dataType: int64
		formatString: 0
		lineageTag: 20000000-0000-0000-0000-000000000072
		summarizeBy: none
		sourceColumn: Orden
		isHidden

	partition 'Parametro Metrica' = calculated
		mode: import
		source =
				DATATABLE(
				    "Metrica", STRING,
				    "Orden", INTEGER,
				    {
				        {"Saldo Cartera", 1},
				        {"Saldo Depósitos", 2}
				    }
				)
