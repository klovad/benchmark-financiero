{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "v05LineTendencia",
  "position": { "x": 30, "y": 250, "z": 2000, "width": 1220, "height": 420, "tabOrder": 4 },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": { "Column": { "Expression": { "SourceRef": { "Entity": "dim_fecha" } }, "Property": "fecha" } },
              "queryRef": "dim_fecha.fecha",
              "nativeQueryRef": "fecha"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "fact_cartera" } }, "Property": "Saldo Cartera" } },
              "queryRef": "fact_cartera.Saldo Cartera",
              "nativeQueryRef": "Saldo Cartera"
            },
            {
              "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "fact_depositos" } }, "Property": "Saldo Depositos" } },
              "queryRef": "fact_depositos.Saldo Depositos",
              "nativeQueryRef": "Saldo Depositos"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
