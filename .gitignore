# Datos crudos descargados de la fuente (se regeneran con el ETL, no se versionan)
data/raw/**
!data/raw/.gitkeep
# respaldos de una carpeta raw reemplazada (p. ej. tras reconstruir la base)
data/raw_*/
data/_tmp_extract/
data/_tmp_inspect/

# Credenciales y configuración local
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Power BI (retirado del repo; restos locales de Desktop no se versionan)
powerbi/
*.pbix

# Playwright
playwright/.cache/

# Salidas regenerables de scripts/ (no versionar snapshots de resultados)
scripts/output/

# Graphify (grafo del código para asistentes, ver CLAUDE.md): local, no se versiona.
# Se regenera con `graphify update .` (los hooks post-commit/post-checkout lo hacen solos).
graphify-out/

# OS / editores
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# Build / herramientas
dist/
build/
.ruff_cache/

# Logs de corridas programadas (scripts/actualizar.*)
logs/
