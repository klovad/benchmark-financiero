# Datos crudos descargados de la fuente (se regeneran con el ETL, no se versionan)
data/raw/**
!data/raw/.gitkeep
data/_tmp_extract/
data/_tmp_inspect/

# Credenciales y configuración local
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Power BI
powerbi/**/.pbi/localSettings.json
powerbi/**/cache.abf
*.pbix

# Playwright
playwright/.cache/

# Salidas regenerables de scripts/ (no versionar snapshots de resultados)
scripts/output/

# Graphify (codebase knowledge graph, ver README): graph.json + GRAPH_REPORT.md
# se versionan (snapshot consultable/legible); el resto (viz interactiva, cache,
# manifest de extracción) es regenerable localmente vía `graphify update .`
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md

# OS / editores
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# Build / herramientas
dist/
build/
.ruff_cache/
