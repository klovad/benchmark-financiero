# Conexión a Postgres. La leen src/benchmark_bancos/config/settings.py, docker-compose.yml
# y sql/00_roles_db.sql (vía \getenv, psql >= 15). Rol y base pueden tener cualquier
# nombre (desde 2026-10-09 ninguna migración fija 'bp_etl'): sql/00 los crea con estos
# valores y `benchmark-bancos migrate`, corrido con este rol, queda dueño de los esquemas.
# Cambiar la contraseña en cualquier servidor real. Ver docs/despliegue_y_orquestacion.md §1.2 y §3.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=benchmark_cartera_depositos
POSTGRES_USER=bp_etl
POSTGRES_PASSWORD=changeme

SCRAPER_YEARS=2021,2022,2023,2024,2025,2026
SCRAPER_DOWNLOAD_DIR=data/raw
